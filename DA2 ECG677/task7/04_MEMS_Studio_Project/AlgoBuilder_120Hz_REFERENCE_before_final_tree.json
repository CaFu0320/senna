            "cssClasses": null,
            "dependency": "ISPU",
            "description": "The configuration for ISPU is stored in json file. Json file could contain sensor configuration toogether with ISPU outputs configuration. This function block doesn't work with offline data because it is implemented inside the sensor.",
            "display_name": "ISPU",
            "function": [
                "extern sensor_hub_data_t sensor_hub_data;",
                "void ISPU_GetData(void *handle, float *Quat_x, float *Quat_y, float *Quat_z, float *Quat_w, int32_t *Sample_counter, float *Gyro_bias_x_dps, float *Gyro_bias_y_dps, float *Gyro_bias_z_dps, float *Acc_x_mg, float *Acc_y_mg, float *Acc_z_mg, float *Gyro_x_mdps, float *Gyro_y_mdps, float *Gyro_z_mdps)",
                "{",
                "  memcpy_float(Quat_x, &sensor_hub_data.ispu_data[0]);",
                "  memcpy_float(Quat_y, &sensor_hub_data.ispu_data[4]);",
                "  memcpy_float(Quat_z, &sensor_hub_data.ispu_data[8]);",
                "  memcpy_float(Quat_w, &sensor_hub_data.ispu_data[12]);",
                "  memcpy_uint32_t(Sample_counter, &sensor_hub_data.ispu_data[16]);",
                "  memcpy_float(Gyro_bias_x_dps, &sensor_hub_data.ispu_data[20]);",
                "  memcpy_float(Gyro_bias_y_dps, &sensor_hub_data.ispu_data[24]);",
                "  memcpy_float(Gyro_bias_z_dps, &sensor_hub_data.ispu_data[28]);",
                "  memcpy_float(Acc_x_mg, &sensor_hub_data.ispu_data[32]);",
                "  memcpy_float(Acc_y_mg, &sensor_hub_data.ispu_data[36]);",
                "  memcpy_float(Acc_z_mg, &sensor_hub_data.ispu_data[40]);",
                "  memcpy_float(Gyro_x_mdps, &sensor_hub_data.ispu_data[44]);",
                "  memcpy_float(Gyro_y_mdps, &sensor_hub_data.ispu_data[48]);",
                "  memcpy_float(Gyro_z_mdps, &sensor_hub_data.ispu_data[52]);",
                "}"
            ],
